+	f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		_ = f.Close()
+	}()
+
+	w := csv.NewWriter(f)
+	defer w.Flush()
+
+	if needHeader {
+		if err := w.Write([]string{
+			"epoch",
+			"start_slot",
+			"private_slot_1",
