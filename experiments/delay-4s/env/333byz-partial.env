# Repository root, derived from the location of this env file.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

# Runtime output directory.
# Override with EXPERIMENT_BASE if a different location is desired.
BASE="${EXPERIMENT_BASE:-$HOME/workspace/devnet/delay-4s-333-partial}"

export EXPERIMENT_MALICIOUS_VALIDATORS_FILE="$REPO_ROOT/experiments/delay-4s/groups/byz_333_first.txt"
export EXPERIMENT_TOTAL_VALIDATORS=1000

export EXPERIMENT_WRITE_REWARDS=1
export EXPERIMENT_PARTIAL_HEAD_REWARD=1
export EXPERIMENT_REWARDS_CSV="$BASE/rewards.csv"

